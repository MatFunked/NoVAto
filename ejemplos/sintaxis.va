# Este es un comentario en NoVAto
de carpeta_vecina.archivo_deseado importar MiClase

constante ADMIN_AUTORIZADO bool = Verdadero
variable intentos_maximos ent = 3 # text, bool, deci, lista, dicc, tupla

func verificar_acceso(usuario: text, edad: ent) -> bool:
    si edad >= 18 and ADMIN_AUTORIZADO:
        print("Acceso concedido para " + usuario)
        retornar Verdadero
    encaso edad <= and ADMIN_AUTORIZADO:
        print("Pronto, niño...")
        retornar Falso
    sino:
        print("Acceso denegado")
        romper ErrorCustom

clase GestorDeAcceso(MiClase):
    func __constructor__(mi, rol: str):
        mi.rol = rol

    func mostrar_rol(mi):
        print("Tu rol es: " + mi.rol)


# print() es exclusivo de python, aunque no estaría mal darle un equivalente, creo que lo dejaré así de momento.